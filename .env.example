# Copy this file to .env and enter keys for the providers you use.
# Leave unused providers blank. Never commit your real keys.
# In the app, choose a configured provider for every council role.
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_CLOUD_API_KEY=
OPENCODE_API_KEY=

