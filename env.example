# Copy this file to .env and paste your keys.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# Optional: override models (run `python council.py --list-models` to see what your keys can use)
CLAUDE_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-2.5-pro
OPENAI_MODEL=gpt-5
# Max output tokens per turn (raise if answers get cut off)
COUNCIL_MAX_TOKENS=4000
