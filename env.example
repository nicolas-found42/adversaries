# Copy this file to .env and paste your keys (or set them in ~/.zshenv).
MISTRAL_API_KEY=mstrl_...
OPENROUTER_API_KEY=sk-or-...
OLLAMA_CLOUD_API_KEY=...
OPENCODE_API_KEY=oc_sk_...

# Optional: override models (run `python council.py --list-models` to see what your keys can use)
MISTRAL_MODEL=mistral-large-latest
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OLLAMA_CLOUD_MODEL=deepseek-v4.1-flash
OPENCODE_GO_MODEL=glm-5.1
# Max output tokens per turn (raise if answers get cut off)
COUNCIL_MAX_TOKENS=4000
